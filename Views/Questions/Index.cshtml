@model IEnumerable<InterviewApp.Models.Question>

@{
    ViewData["Title"] = "Interview Questions";
}

<h1>Interview Questions</h1>

<p class="page-intro">Practice real interview questions, track your answers, and build confidence.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Question</a>
</p>

@if (!Model.Any())
{
    <p>No interview questions have been added yet.</p>
}
else
{
    <div class="table-panel table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Difficulty</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var question in Model)
            {
                <tr>
                    <td>@question.Title</td>
                    <td>@question.Category?.Name</td>
                    <td>@question.Difficulty</td>
                    <td>
                        <a class="action-link" asp-action="Details" asp-route-id="@question.Id">
                            View Details
                        </a>
                          |
                         <a class="action-link" asp-action="Edit" asp-route-id="@question.Id">
                             Edit
                        </a>
                            |
                        <a class="action-link action-link-danger" asp-action="Delete" asp-route-id="@question.Id">
                             Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}