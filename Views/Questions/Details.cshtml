@model InterviewApp.Models.Question

@{
    ViewData["Title"] = "Question Details";
}

<h1>Question Details</h1>

<div class="panel">
    <h4>@Model.Title</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Category
        </dt>
        <dd class="col-sm-9 question-content">
            @Model.Category?.Name
        </dd>

        <dt class="col-sm-3">
            Difficulty
        </dt>
        <dd class="col-sm-9">
            @Model.Difficulty
        </dd>

        <dt class="col-sm-3">
            Question
        </dt>
        <dd class="col-sm-9">
            @Model.Content
        </dd>
    </dl>
</div>
<hr />

<h3>Practice This Question</h3>

<form asp-controller="Attempts" asp-action="Create" method="post">
    <input type="hidden" name="QuestionId" value="@Model.Id" />

    <div class="mb-3">
        <label for="AnswerText" class="form-label">Your Answer</label>
        <textarea id="AnswerText"
                  name="AnswerText"
                  class="form-control"
                  rows="6"
                  placeholder="Write your interview answer here..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Answer
    </button>
</form>
<hr />

<h3>My Previous Answers</h3>

@if (ViewBag.MyAttempts is IEnumerable<InterviewApp.Models.Attempt> attempts
    && attempts.Any())
{
    foreach (var attempt in attempts)
    {
        <div class="attempt-card mb-3">
            <div class="card-body">
                <p class="card-text">@attempt.AnswerText</p>
                <small class="text-muted">
                    Submitted at: @attempt.AttemptedAt.ToLocalTime()
                </small>
            </div>
        </div>
    }
}
else
{
    <p>You have not submitted an answer for this question yet.</p>
}
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to Questions</a>
</div>