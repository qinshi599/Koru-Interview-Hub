@model InterviewApp.Models.Question

@{
    ViewData["Title"] = "Question Details";
}

<h1>Question Details</h1>

<div class="panel">
    <h4>@Model.Title</h4>

    <div class="meta-row">
        <span class="badge-pill">@Model.Category?.Name</span>
        <span class="badge-pill badge-pill-outline">@Model.Difficulty</span>
    </div>

    <hr />

    <p class="question-content">@Model.Content</p>

    @if (Model.FollowUpQuestions.Any())
    {
        <hr />
        <p class="mb-1"><strong>The interviewer might also ask:</strong></p>
        <ul>
            @foreach (var followUp in Model.FollowUpQuestions)
            {
                <li>@followUp.Text</li>
            }
        </ul>
    }
</div>
<hr />

<h3>Practice This Question</h3>

<form asp-controller="Attempts" asp-action="Create" method="post">
    <input type="hidden" name="QuestionId" value="@Model.Id" />

    <div class="mb-3">
        <label for="AnswerText" class="form-label">Your Answer</label>
        <textarea id="AnswerText"
                  name="AnswerText"
                  class="form-control"
                  rows="6"
                  placeholder="Write your interview answer here..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Answer
    </button>
</form>
<hr />

<h3>My Previous Answers</h3>

@if (ViewBag.MyAttempts is IEnumerable<InterviewApp.Models.Attempt> attempts
    && attempts.Any())
{
    foreach (var attempt in attempts)
    {
        <div class="attempt-card mb-3">
            <div class="card-body">
                <p class="card-text">@attempt.AnswerText</p>
                @if (attempt.Score.HasValue)
                {
                    <div class="meta-row">
                        <span class="badge-pill">AI Score: @attempt.Score / 100</span>
                    </div>
                    <p class="card-text text-muted">@attempt.Feedback</p>
                }
                <small class="text-muted">
                    Submitted at: @attempt.AttemptedAt.ToLocalTime()
                </small>
                <form asp-controller="Attempts" asp-action="Delete" method="post"
                      onsubmit="return confirm('Delete this answer?');" class="mt-2">
                    <input type="hidden" name="id" value="@attempt.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </div>
        </div>
    }
}
else
{
    <p>You have not submitted an answer for this question yet.</p>
}
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to Questions</a>
</div>