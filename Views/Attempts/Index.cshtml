@model IEnumerable<InterviewApp.Models.Attempt>

@{
    ViewData["Title"] = "My Practice Attempts";
}

<h1>My Practice Attempts</h1>

<p class="page-intro">Review your previous answers and keep improving your interview preparation.</p>

@if (!Model.Any())
{
    <p>You have not submitted any answers yet.</p>
}
else
{
    <div class="table-panel table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Question</th>
                <th>Your Answer</th>
                <th>AI Score</th>
                <th>AI Feedback</th>
                <th>Submitted At</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attempt in Model)
            {
                <tr>
                    <td>
                        @attempt.Question?.Title
                    </td>
                    <td class="text-muted">
                        @attempt.AnswerText
                    </td>
                    <td class="text-muted">
                        @(attempt.Score.HasValue ? $"{attempt.Score}/100" : "-")
                    </td>
                    <td class="text-muted">
                        @attempt.Feedback
                    </td>
                    <td class="text-muted">
                        @attempt.AttemptedAt.ToLocalTime().ToString("d MMM yyyy")
                    </td>
                    <td>
                        <form asp-controller="Attempts" asp-action="Delete" method="post"
                              onsubmit="return confirm('Delete this answer?');">
                            <input type="hidden" name="id" value="@attempt.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}